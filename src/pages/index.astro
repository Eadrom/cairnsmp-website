---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyAddress from '../components/CopyAddress.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import cairnLogo from '../assets/branding/cairnsmp-logo.png';
import { site } from '../data/site';

const releases = (await getCollection('changelog')).filter((entry) => entry.data.published).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latest = releases[0];
const releaseDate = latest?.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
---

<BaseLayout
  title="Cairn SMP"
  description="Find your trail on Cairn SMP, a small Minecraft Java survival community for friends, guildmates, and new travelers."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-landscape" aria-hidden="true">
      <svg viewBox="0 0 1000 520" preserveAspectRatio="xMidYMid slice">
        <path class="ridge ridge-back" d="M0 365 110 266l78 57 142-180 122 146 110-112 173 155 97-101 168 120v169H0Z" />
        <path class="ridge ridge-mid" d="M0 417 159 299l106 91 172-141 92 108 127-68 151 107 96-72 97 68v128H0Z" />
        <path class="ridge ridge-front" d="M0 461 165 391l139 57 155-80 149 58 136-83 256 97v80H0Z" />
      </svg>
    </div>
    <div class="hero-inner">
      <div class="hero-content">
        <p class="eyebrow"><span></span> Minecraft Java · Survival</p>
        <h1 id="hero-title">Find your trail.<br /><em>Build something lasting.</em></h1>
        <p class="hero-copy">A small world of friends, guildmates, and new travelers. Settle in, head out, and make a little corner of it your own.</p>
        <div class="hero-actions">
          <a class="button-link gold" href="/play/">How to play <span aria-hidden="true">→</span></a>
          <a class="text-link" href="#discover">Discover Cairn <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-server">
          <CopyAddress />
          <p>Java Edition <span>{site.minecraftVersion}</span></p>
        </div>
      </div>
      <div class="hero-brand-art" aria-hidden="true">
        <Image src={cairnLogo} alt="" width={520} height={520} sizes="(max-width: 700px) 184px, (max-width: 980px) 34vw, 440px" format="webp" quality={84} loading="eager" fetchpriority="high" />
      </div>
    </div>
    <div class="hero-footnote"><span>Community first. Adventure follows.</span><a href="/about/">Our story <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="features-section content-section" id="discover" aria-labelledby="features-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">A little more to discover</p>
        <h2 id="features-title">Familiar world.<br />New possibilities.</h2>
      </div>
      <div class="section-description">
        <p>Survival at heart, with more to find along the way. Gear to hunt for, skills to grow, and a place to call home.</p>
        <a class="text-link dark" href="/features/">Explore the handbook <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <FeatureGrid />
    <p class="guide-note">We’re still adding to the feature guides. You’ll find more details in the <a href="/commands/">command reference</a> and <a href="/changelog/">release notes</a>.</p>
  </section>

  <section class="handbook-section" aria-labelledby="handbook-title">
    <div class="content-section handbook-inner">
      <div class="handbook-heading">
        <p class="section-kicker light">Your field guide</p>
        <h2 id="handbook-title">A good place<br />to get your bearings.</h2>
        <p>First visit or familiar face, here’s where to find your next step.</p>
      </div>
      <div class="handbook-links">
        <a href="/play/"><span class="waypoint-number" aria-hidden="true">01</span><div><h3>Join the server</h3><p>Edition, version, and a quick joining guide.</p></div><span class="waypoint-arrow" aria-hidden="true">↗</span></a>
        <a href="/commands/"><span class="waypoint-number" aria-hidden="true">02</span><div><h3>Find a command</h3><p>Homes, claims, shops, skills, and more.</p></div><span class="waypoint-arrow" aria-hidden="true">↗</span></a>
        <a href="/faq/"><span class="waypoint-number" aria-hidden="true">03</span><div><h3>A few quick answers</h3><p>The essentials, before you set out.</p></div><span class="waypoint-arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="update-section content-section" aria-label="Server news and community">
    <div class="latest-update">
      <p class="section-kicker">From the logbook</p>
      {latest ? (
        <>
          <p class="update-meta"><span>Version {latest.data.version}</span><time datetime={latest.data.date.toISOString()}>{releaseDate}</time></p>
          <h2>{latest.data.title}</h2>
          <p class="update-summary">{latest.data.summary}</p>
          <a class="text-link dark" href={`/changelog/${latest.id}/`}>Read the release notes <span aria-hidden="true">→</span></a>
        </>
      ) : (
        <>
          <h2>The next chapter starts here.</h2>
          <p class="update-summary">Server news and release notes will appear here as they’re published.</p>
          <a class="text-link dark" href="/changelog/">Open the changelog <span aria-hidden="true">→</span></a>
        </>
      )}
    </div>
    <aside class="community-card" id="community">
      <p class="section-kicker light">Around the campfire</p>
      <h2>Come say hello.</h2>
      <p>Cairn started with friends and guildmates. Meet the people who call it home, ask a question, or share what you’re building.</p>
      <a class="button-link light" href={site.discordUrl}>Join the Discord <span aria-hidden="true">↗</span></a>
    </aside>
  </section>
</BaseLayout>
