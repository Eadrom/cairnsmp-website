---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Trail not found" description="The requested Cairn SMP page could not be found." noindex>
  <section class="not-found">
    <p class="eyebrow dark"><span></span> Error 404</p>
    <h1>This trail doesn’t go any farther.</h1>
    <p>The page may have moved, or the marker you followed may be out of date.</p>
    <div>
      <a class="button-link dark" href="/">Return home</a>
      <a class="text-link dark" href="/features/">Open the handbook <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
