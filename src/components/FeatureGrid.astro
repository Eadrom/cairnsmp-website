---
import { features } from '../data/features';

const { compact = false } = Astro.props;
const icons: Record<(typeof features)[number]['title'], string> = {
  'Stat Gear': 'M14 3h7v7L9 22l-7-7L14 3Zm0 0 7 7M6 11l7 7M3 21l3-3',
  AuraSkills: 'M12 21V11M12 16C5 16 3 12 3 7c6 0 9 3 9 9Zm0-5c0-5 3-8 9-8 0 6-3 8-9 8Z',
  'Custom Enchants': 'M12 6C9 3 5 3 2 4v15c4-1 7 0 10 2 3-2 6-3 10-2V4c-3-1-7-1-10 2Zm0 0v15M5 8l4 1M15 9l4-1',
  'Levelled Mobs': 'M5 18v-4a8 8 0 1 1 14 0v4h-4v3H9v-3H5Zm3-8h1v2H8v-2Zm7 0h1v2h-1v-2Z',
  Claims: 'm3 11 9-8 9 8M5 10v11h14V10M9 21v-7h6v7',
};
---

<div class:list={['feature-grid', { compact }]}>
  {features.map((feature) => (
    <a class="feature-card" href={feature.href}>
      <div class="feature-card-top" aria-hidden="true">
        <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d={icons[feature.title]} /></svg>
        <span class="feature-marker">{feature.marker}</span>
      </div>
      <div>
        <h3>{feature.title}</h3>
        <p>{feature.description}</p>
        <span class="card-link">Open guide <span aria-hidden="true">→</span></span>
      </div>
    </a>
  ))}
</div>
