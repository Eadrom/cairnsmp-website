---
const { compact = false } = Astro.props;
const currentPath = Astro.url.pathname;

const links = [
  { label: 'Play', href: '/play/' },
  { label: 'Features', href: '/features/' },
  { label: 'Rules', href: '/rules/' },
  { label: 'Commands', href: '/commands/' },
  { label: 'Changelog', href: '/changelog/' },
  { label: 'Discord', href: 'https://discord.gg/6p8UXyXMzr' },
];
---

<nav class:list={['site-nav', { compact }]} aria-label="Primary navigation">
  {links.map(({ label, href }) => {
    const isInternal = href.startsWith('/');
    const isActive = isInternal && (currentPath === href || currentPath.startsWith(href));
    return <a class:list={{ active: isActive }} href={href} aria-current={isActive ? 'page' : undefined}>{label}</a>;
  })}
</nav>
