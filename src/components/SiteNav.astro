---
import { site } from '../data/site';

const { compact = false } = Astro.props;
const currentPath = Astro.url.pathname;

const links = [
  { label: 'Handbook', href: '/features/' },
  { label: 'Commands', href: '/commands/' },
  { label: 'Changelog', href: '/changelog/' },
  { label: 'Discord', href: site.discordUrl },
  { label: 'How to play', href: '/play/' },
];
---

<nav class:list={['site-nav', { compact }]} aria-label="Primary navigation">
  {links.map(({ label, href }) => {
    const isInternal = href.startsWith('/');
    const isActive = isInternal && (currentPath === href || currentPath.startsWith(href));
    return <a class:list={{ active: isActive, 'nav-play': href === '/play/' }} href={href} aria-current={isActive ? 'page' : undefined}>{label}</a>;
  })}
</nav>
